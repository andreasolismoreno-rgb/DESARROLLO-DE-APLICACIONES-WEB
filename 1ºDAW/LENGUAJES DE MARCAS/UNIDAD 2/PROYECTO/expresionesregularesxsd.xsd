<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name = "Expresiones">
        <xs:complexType>
            <xs:sequence>
                <xs:element name = "Expresion1">
                    <xs:simpleType>
                        <xs:restriction base="xs:decimal">
                            <xs:pattern value = "Capítulo \d ">
                            </xs:pattern>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name = "Expresion2">
                    <xs:simpleType>
                        <xs:restriction base="xs:decimal">
                            <xs:pattern value = "Capítulo \d{1,2}">
                            </xs:pattern>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>