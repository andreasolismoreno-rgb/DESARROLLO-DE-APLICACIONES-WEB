<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="pagos">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="nombre" maxOccurs="3" minOccurs="0">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="dni" use="required">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:maxLength value="10"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>

        <xs:element name="fechaNacimiento">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:date">
                <xs:attribute name="edad" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:integer">
                      <xs:minInclusive value="16"/>
                      <xs:maxInclusive value="24"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>

        <xs:element name="hora" type="xs:time" minOccurs="0" maxOccurs="unbounded"/>

        <xs:element name="precio" type="xs:decimal"/>

        <xs:element name="cantidad">
          <xs:simpleType>
            <xs:restriction base="xs:integer">
              <xs:pattern value="678"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        
        <xs:element name="pagado" type="xs:boolean" default="false"/>

      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
